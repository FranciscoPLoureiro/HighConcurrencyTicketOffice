# Copy to .env and adjust as needed.
#
# Every value here is optional: the defaults target the docker-compose stack, so
# a fresh clone runs with no configuration at all. A deployment is expected to
# set all of them.

# Listen address for the API server.
HTTP_ADDR=:8080

# PostgreSQL — the source of truth. Everything else is recoverable from here.
POSTGRES_DSN=postgres://tickets:tickets@localhost:5432/tickets?sslmode=disable

# Redis — where the ticket stock invariant is enforced.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# The campaign this process serves, and how large it is. The campaign row is
# created from these once and never resized, so changing TOTAL_TICKETS does not
# resize a campaign that has already started selling.
CAMPAIGN_ID=queima-2026
TOTAL_TICKETS=100

# Rate limiting on the purchase endpoint. Either limit set to 0 disables that
# check; the window applies to both.
#
# The per-address limit is deliberately loose: the audience is a university,
# where thousands of students share a handful of NAT addresses, so a tight one
# blocks a hall of residence rather than an attacker. Note that the load
# generator drives every virtual user from one address, so raising VUS above
# RATE_LIMIT_IP makes the generator rate limit itself.
RATE_LIMIT_WINDOW=10s
RATE_LIMIT_USER=5
RATE_LIMIT_IP=1000

# Idempotency-Key handling on the purchase endpoint. Both must be positive:
# either one at zero would silently stop the endpoint being idempotent while it
# still demands the header that says it is.
#
# The lease is how long an unfinished request holds its key against a retry. It
# has to outlast the request it protects, or a retry arriving while the first
# attempt is still working claims a key that was never free.
#
# The retention is how long the answer stays replayable — how long after giving
# up somebody might try again. Past it a retry gets the ordinary refusal for
# someone who already holds a ticket: true, and less useful than their ticket.
IDEMPOTENCY_LEASE=30s
IDEMPOTENCY_RETENTION=24h

# How long a process waits for in-flight work after SIGTERM before exiting
# anyway. Must be positive.
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
