# Copy to .env and adjust as needed.
#
# Every value here is optional: the defaults target the docker-compose stack, so
# a fresh clone runs with no configuration at all. A deployment is expected to
# set all of them.

# Listen address for the API server.
HTTP_ADDR=:8080

# PostgreSQL — the source of truth. Everything else is recoverable from here.
POSTGRES_DSN=postgres://tickets:tickets@localhost:5432/tickets?sslmode=disable

# Redis — where the ticket stock invariant is enforced.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# How long a process waits for in-flight work after SIGTERM before exiting
# anyway. Must be positive.
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
